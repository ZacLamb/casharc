<section class="cta-band">
  <svg class="arc-bg" viewBox="0 0 800 400" aria-hidden="true"><path d="M-50 380 C 150 40, 650 40, 850 380" fill="none" stroke="currentColor" stroke-width="60" opacity=".12"/></svg>
  <div class="wrap cta-inner">
    <h2><%= typeof heading !== 'undefined' ? heading : 'See what your business qualifies for today' %></h2>
    <p>Two-minute application. No hard credit pull to apply. Decisions as fast as same day.</p>
    <a href="/apply" class="btn btn-gold btn-lg">Start my application <%- include('icon', { name: 'arrow' }) %></a>
  </div>
</section>
